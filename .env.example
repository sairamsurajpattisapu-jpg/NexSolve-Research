# =============================================================================
# NexSolve Production Environment Configuration Example
# Copy this file to .env and adjust values for your deployment.
# NEVER commit actual passwords, secrets, or API keys to version control.
# =============================================================================

# Server Binding
NEXSOLVE_HOST=0.0.0.0
NEXSOLVE_PORT=8001
NEXSOLVE_ENV=production
NEXSOLVE_LOG_LEVEL=info

# Cross-Origin Resource Sharing (comma-separated list of allowed frontend origins)
NEXSOLVE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
# Leave unset or empty to run in MEMORY MODE (local development & demo fallback).
# Set to a valid PostgreSQL connection string for production persistence:
# DATABASE_URL=postgresql+psycopg://nexsolve_user:nexsolve_password@localhost:5432/nexsolve_db
DATABASE_URL=

# Safety & Resource Bounds
NEXSOLVE_MAX_UPLOAD_BYTES=1073741824
NEXSOLVE_MAX_PACKETS=100000
NEXSOLVE_MAX_FLOWS=20000
NEXSOLVE_MAX_TEMPORAL_WINDOWS=500
NEXSOLVE_MAX_CONCURRENT_JOBS=4
NEXSOLVE_MAX_PROCESSING_SECONDS=120.0
NEXSOLVE_MAX_LOOKBACK_WINDOWS=256

# Frontend API Target (used by frontend build/runtime)
VITE_API_BASE_URL=http://localhost:8001
