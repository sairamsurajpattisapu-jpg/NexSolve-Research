# NexSolve Frontend Environment Configuration
# - Development: If unset or empty, Vite proxies /api, /jobs, /health, /ready to http://127.0.0.1:8001.
# - Docker / Nginx: Leave unset/empty (VITE_API_BASE_URL="") so Nginx reverse-proxies to backend.
# - Vercel / Cloud: Set VITE_API_BASE_URL to the public HTTPS URL of your deployed backend service:
#   VITE_API_BASE_URL=https://your-nexsolve-backend.example.com
VITE_API_BASE_URL=http://localhost:8001

